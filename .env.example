# --- AI Provider ---
AI_OPENAI_API_KEY=sk-C4xUbLu33OwWRuGm4Dr15rTNGowjhNjP95JtOZXQ3Rc3lvPH
AI_OPENAI_BASE_URL=https://api.gapgpt.app/v1
AI_DEFAULT_MODEL_KEY=gpt-4o-mini

# --- Celery + Redis ---
AI_GENERATION_MODE=celery
AI_STREAM_TRANSPORT=redis

# --- Notifications ---
# فایل service-account فایربیس را در docker/secrets/firebase-service-account.json بگذارید (گیت نمی‌شود).
NOTIF_DELIVERY_MODE=celery
FIREBASE_CREDENTIALS=/secrets/firebase-service-account.json
NOTIF_DEFAULT_QUIET_HOURS=23:00-07:00
NOTIF_DAILY_CAP_NORMAL=10
NOTIF_DAILY_CAP_LOW=3
NOTIF_WEB_LINK_BASE=https://space.mydesko.ir
# پیکربندی Firebase وب (Web Push در PWA)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=desko-fb8e4
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# --- Frontend (همان origin سرور) ---
VITE_API_URL=/api/

# ایمیج‌ها همان نام رسمی Docker Hub هستند تا کش قبلی سرور استفاده شود.
# اگر pull از Hub timeout شد، ایمیج را روی سیستم با اینترنت ذخیره و روی سرور load کنید:
#   docker save nginx:stable-alpine | gzip > nginx.tgz
#   scp nginx.tgz root@server: && docker load < nginx.tgz
# یا /etc/docker/daemon.json را از docker/daemon.json.example کپی و Docker را ریستارت کنید.
