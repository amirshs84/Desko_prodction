# بیلد موبایل: npm run build:mobile  (Vite این فایل را با --mode mobile می‌خواند)
#
# یکی از حالت‌ها را فعال نگه دار (بقیه را کامنت کن):
# - ایمولیتور اندروید → هاست شما روی PC: 10.0.2.2
# - گوشی واقعی همان Wi‑Fi → IP لوکال PC مثلاً http://192.168.1.10:8000/api/
# - پروداکشن / سرور فعلی → http://space.mydesko.ir/api/
# وقتی SSL دامنه فعال شد، این را به https تغییر دهید.

VITE_API_URL=http://space.mydesko.ir/api/
