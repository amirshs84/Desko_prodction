{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run copy:pdfassets && vite",
    "copy:pdfassets": "node scripts/copy-pdfjs-assets.mjs",
    "build": "npm run copy:pdfassets && vite build",
    "build:mobile": "npm run copy:pdfassets && vite build --mode mobile",
    "cap:sync": "npx cap sync android",
    "android:bundle": "npm run build:mobile && node scripts/strip-apk-from-dist.mjs && npx cap sync android",
    "assets:android": "npx --yes @capacitor/assets@3 generate --android --androidProject android",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-static-copy": "^4.1.0"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@embedpdf/engines": "^2.15.0",
    "@embedpdf/pdfium": "^2.15.0",
    "@tanstack/query-sync-storage-persister": "^5.101.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-persist-client": "^5.101.0",
    "axios": "^1.13.4",
    "framer-motion": "^12.40.0",
    "jalaali-js": "^1.2.8",
    "lucide-react": "^1.18.0",
    "mupdf": "^1.27.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.3",
    "react-calendar-heatmap": "^1.10.0",
    "react-dom": "^19.2.3",
    "react-icons": "^5.2.1",
    "react-router-dom": "^7.11.0",
    "recharts": "^3.6.0"
  }
}
